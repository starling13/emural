code = "shader_type spatial;
render_mode specular_schlick_ggx, async_visible;

uniform vec4 decal_color : hint_color = vec4(1.000000, 0.927140, 0.000000, 1.000000);
uniform vec4 base_color : hint_color = vec4(1.000000, 0.000000, 0.000000, 1.000000);
uniform sampler2D decal : hint_albedo;



void vertex() {
// Output:0

}

void fragment() {
// ColorUniform:3
	vec3 n_out3p0 = decal_color.rgb;
	float n_out3p1 = decal_color.a;

// ColorUniform:2
	vec3 n_out2p0 = base_color.rgb;
	float n_out2p1 = base_color.a;

// Input:6
	vec3 n_out6p0 = vec3(UV, 0.0);

// Texture:8
	vec3 n_out8p0;
	float n_out8p1;
	{
		vec4 decal_tex_read = texture(decal, n_out6p0.xy);
		n_out8p0 = decal_tex_read.rgb;
		n_out8p1 = decal_tex_read.a;
	}

// VectorMix:7
	vec3 n_out7p0 = mix(n_out3p0, n_out2p0, vec3(n_out8p1));

// Output:0
	ALBEDO = n_out7p0;

}

void light() {
// Output:0

}
